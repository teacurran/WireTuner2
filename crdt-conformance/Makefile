# crdt-conformance (docs/spec/testing.adoc "Conformance vectors", backlog CRDT-011).  Run from
# anywhere with `make -C crdt-conformance <target>`:
#
#   run       replay every vector through both engines, then fuzz (the root `make conformance`)
#   swift     WTCRDT only: `swift test --filter ConformanceTests`
#   java      wt-crdt only: server/conformance's ConformanceTest (needs Go and protoc for the
#             merge table, like every wt-crdt build)
#   fuzz      the cross-engine fuzzer (CRDT-012, docs/spec/testing.adoc "Fuzzing"): WTCRDT
#             generates FUZZ_OPS random ops (default 20,000; the nightly run passes 1000000 and
#             FUZZ_SWIFT='-c release -Xswiftc -enable-testing') from FUZZ_SEED into the corpus
#             FUZZ_CORPUS and checks every delivery itself, then wt-crdt replays the corpus; a
#             vector wt-crdt disagrees on is minimised against the Java oracle into
#             $(FUZZ_CORPUS)-minimized, as WTCRDT minimises its own failures
#   fuzz-minimize  minimise the vectors listed in $(FUZZ_CORPUS)-java-failures.txt
#   generate  regenerate the committed Swift for schema/vector.proto; the Java is generated by
#             server/conformance's Maven build
#
# `generate` builds protoc-gen-swift from swift-protobuf at the version WTProto pins, into .build/
# (gitignored), and compiles vector.proto against the proto/ module described by
# tools/protoc-gen-wtcrdt's wtcrdt-descriptors (buf/validate/validate.proto without the BSR).

ROOT            := $(abspath ..)
BUILD           := $(CURDIR)/.build
SWIFT_PROTOBUF  := 1.38.1
PLUGIN          := $(BUILD)/swift-protobuf-$(SWIFT_PROTOBUF)/.build/release/protoc-gen-swift
SWIFT_OUT       := $(ROOT)/client/Packages/WTCRDT/Tests/WTCRDTTests/Conformance/Generated
# JDK 25: the sdkman install when present (the default `java` on a dev Mac may be older),
# else whatever JAVA_HOME the environment has (CI's setup-java).  Override with JDK=<path>.
SDKMAN_JDK      := $(HOME)/.sdkman/candidates/java/25-amzn
JDK             ?= $(if $(wildcard $(SDKMAN_JDK)),$(SDKMAN_JDK),$(JAVA_HOME))

FUZZ_OPS        ?= 20000
FUZZ_SEED       ?= 1
FUZZ_CORPUS     ?= $(BUILD)/fuzz-corpus
FUZZ_SWIFT      ?=
CONFORMANCE     := $(ROOT)/server/conformance/target
ORACLE          := $(JDK)/bin/java -cp "$$(cat $(CONFORMANCE)/test-classpath.txt):$(CONFORMANCE)/test-classes:$(CONFORMANCE)/classes" com.villagecompute.wiretuner.conformance.FuzzOracle

.PHONY: run swift java fuzz fuzz-minimize generate clean

run: swift java fuzz

swift:
	cd $(ROOT)/client/Packages/WTCRDT && swift test --filter ConformanceTests

java:
	cd $(ROOT)/server && JAVA_HOME=$(JDK) ./mvnw -q -pl conformance -am test \
		-Dtest=ConformanceTest -Dsurefire.failIfNoSpecifiedTests=false

fuzz:
	rm -rf $(FUZZ_CORPUS) $(FUZZ_CORPUS)-minimized $(FUZZ_CORPUS)-java-failures.txt
	cd $(ROOT)/client/Packages/WTCRDT && WT_FUZZ_OPS=$(FUZZ_OPS) WT_FUZZ_SEED=$(FUZZ_SEED) WT_FUZZ_CORPUS=$(FUZZ_CORPUS) \
		swift test $(FUZZ_SWIFT) --filter generatedVectorsConvergeInWTCRDT
	cd $(ROOT)/server && WT_FUZZ_CORPUS=$(FUZZ_CORPUS) JAVA_HOME=$(JDK) ./mvnw -q -pl conformance -am test \
		-Dtest=FuzzCorpusTest -Dsurefire.failIfNoSpecifiedTests=false || { $(MAKE) fuzz-minimize; exit 1; }

fuzz-minimize:
	cd $(ROOT)/client/Packages/WTCRDT && WT_FUZZ_MINIMIZE="$$(paste -sd: - < $(FUZZ_CORPUS)-java-failures.txt)" \
		WT_FUZZ_ORACLE='$(ORACLE)' swift test $(FUZZ_SWIFT) --filter crossEngineMinimisation

$(PLUGIN):
	rm -rf $(BUILD)/swift-protobuf-$(SWIFT_PROTOBUF)
	git clone -q --depth 1 --branch $(SWIFT_PROTOBUF) https://github.com/apple/swift-protobuf \
		$(BUILD)/swift-protobuf-$(SWIFT_PROTOBUF)
	cd $(BUILD)/swift-protobuf-$(SWIFT_PROTOBUF) && swift build -c release --product protoc-gen-swift

generate: $(PLUGIN)
	mkdir -p $(BUILD) $(SWIFT_OUT)
	cd $(ROOT)/tools/protoc-gen-wtcrdt && go run ./cmd/wtcrdt-descriptors $(ROOT)/proto $(BUILD)/doc.binpb
	protoc --descriptor_set_in=$(BUILD)/doc.binpb -I $(CURDIR)/schema \
		--plugin=protoc-gen-swift=$(PLUGIN) \
		--swift_out=$(SWIFT_OUT) \
		--swift_opt=Visibility=Internal,ProtoPathModuleMappings=$(CURDIR)/schema/swift-module-mappings.asciipb \
		vector.proto

clean:
	rm -rf $(BUILD)
