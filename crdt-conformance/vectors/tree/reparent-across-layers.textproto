# crdt-conformance/vectors/tree/reparent-across-layers.textproto (CRDT-002; schema: crdt-conformance/schema/vector.proto)
name: "tree/reparent-across-layers"
description: "Replica 1 moves O1 from layer 1 to the front of layer 2 and renames it; replica 2 moves O2 to the back of layer 2 and P from layer 2 to layer 1, then locks O1.  Every move applies (no conflict), both layers read the same children on every delivery order, and the edits follow the moved nodes."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Create layers and objects"
    ops { create { parent { counter: 4 } position: "\x80" props { layer { common { name: "Layer 1" } } } } }
    ops { create { parent { counter: 4 } position: "\x81" props { layer { common { name: "Layer 2" } } } } }
    ops { create { parent { counter: 1 replica: 7 } position: "\x80" props { group { common { name: "O1" } } } } }
    ops { create { parent { counter: 1 replica: 7 } position: "\x81" props { group { common { name: "O2" } } } } }
    ops { create { parent { counter: 2 replica: 7 } position: "\x80" props { group { common { name: "P" } } } } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 6 base_server_seq: 1 label: "Move O1 to layer 2"
    ops { move { node { counter: 3 replica: 7 } parent { counter: 2 replica: 7 } position: "\x81" } }
    ops { set { node { counter: 3 replica: 7 }
      paths { segments { field: 50 } segments { field: 1 } segments { field: 1 } }
      values { group { common { name: "O1 moved" } } } } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 6 base_server_seq: 1 label: "Move O2 to layer 2, P to layer 1"
    ops { move { node { counter: 4 replica: 7 } parent { counter: 2 replica: 7 } position: "\x7f" } }
    ops { move { node { counter: 5 replica: 7 } parent { counter: 1 replica: 7 } position: "\x90" } }
  }
  change {
    replica: 2 seq: 2 start_counter: 8 base_server_seq: 1 label: "Lock O1"
    ops { set { node { counter: 3 replica: 7 }
      paths { segments { field: 50 } segments { field: 1 } segments { field: 3 } }
      values { group { common { locked: true } } } } }
  }
}
deliveries { order: [1, 2, 2] }
deliveries { order: [2, 2, 1] }
deliveries { order: [2, 1, 2] }
expect {
  state_hash: "384067365d5d5f3ee41a68a5536cadc3ec4e579b684328193f21464ed1687972"
  snapshot_hash: "3b60f6f308020ed3631def44db757778993d9759df4c5a9ca9584c199759f491"
  node { id { counter: 1 replica: 7 } node_hash: "08593f05687ca21a7a3f7156778c1a971df0157b5bae992a0f4ca7c748886a57" tree { parent { counter: 4 } position: "\x80" children { counter: 5 replica: 7 } } }
  node {
    id { counter: 2 replica: 7 }
    node_hash: "a0ecbf47e6123465d7544cb6ce34f815b928565ab574c636be60de697934aa5c"
    tree { parent { counter: 4 } position: "\x81" children { counter: 4 replica: 7 } children { counter: 3 replica: 7 } }
  }
  node {
    id { counter: 3 replica: 7 }
    node_hash: "7f468340f5a4259764ab5c70696231340f5c5a7de1ecd42d5f35b75c79b4fb37"
    tree { parent { counter: 2 replica: 7 } position: "\x81" }
    register {
      path { segments { field: 50 } segments { field: 1 } segments { field: 1 } }
      value { group { common { name: "O1 moved" } } }
      op { counter: 7 replica: 1 }
      losing { counter: 3 replica: 7 }
    }
    register {
      path { segments { field: 50 } segments { field: 1 } segments { field: 3 } }
      value { group { common { locked: true } } }
      op { counter: 8 replica: 2 }
    }
  }
}
