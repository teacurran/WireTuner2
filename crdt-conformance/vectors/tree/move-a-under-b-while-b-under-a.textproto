# crdt-conformance/vectors/tree/move-a-under-b-while-b-under-a.textproto (CRDT-002; schema: crdt-conformance/schema/vector.proto)
name: "tree/move-a-under-b-while-b-under-a"
description: "Concurrently, replica 1 moves group A under B and replica 2 moves B under A; a third moves B under C while C moves under A.  In OpId order A-under-B (4:1) applies, B-under-A (4:2) would make B its own ancestor and is skipped, B-under-C (6:3) applies, and C-under-A (6:4) is skipped for the same reason: no cycle on any delivery order."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Create layer and groups"
    ops { create { parent { counter: 4 } position: "\x80" props { layer { common { name: "Layer 1" } } } } }
    ops { create { parent { counter: 1 replica: 7 } position: "\x80" props { group { common { name: "A" } } } } }
    ops { create { parent { counter: 1 replica: 7 } position: "\x81" props { group { common { name: "B" } } } } }
  }
  change {
    replica: 7 seq: 2 start_counter: 4 label: "Create C"
    ops { noop {} }
    ops { create { parent { counter: 1 replica: 7 } position: "\x82" props { group { common { name: "C" } } } } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 4 base_server_seq: 1 label: "A into B"
    ops { move { node { counter: 2 replica: 7 } parent { counter: 3 replica: 7 } position: "\x80" } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 4 base_server_seq: 1 label: "B into A"
    ops { move { node { counter: 3 replica: 7 } parent { counter: 2 replica: 7 } position: "\x80" } }
  }
}
replica {
  id: 3
  change {
    replica: 3 seq: 1 start_counter: 6 base_server_seq: 2 label: "B into C"
    ops { move { node { counter: 3 replica: 7 } parent { counter: 5 replica: 7 } position: "\x80" } }
  }
}
replica {
  id: 4
  change {
    replica: 4 seq: 1 start_counter: 6 base_server_seq: 2 label: "C into A"
    ops { move { node { counter: 5 replica: 7 } parent { counter: 2 replica: 7 } position: "\x80" } }
  }
}
deliveries { order: [1, 2, 3, 4] }
deliveries { order: [4, 3, 2, 1] }
deliveries { order: [2, 4, 1, 3] }
deliveries { order: [3, 1, 4, 2] }
expect {
  state_hash: "c42b29acfe484fde72e3ce4afd8425a9843914a17f4049ac8a03cc6f011c5d75"
  snapshot_hash: "5d9feda1c57c16976ebf2f90f65f2ab26b1c84c951b245c0e4d72730d3cf4ba6"
  node { id { counter: 2 replica: 7 } node_hash: "f1d929fc6f6479029bae327742164ef1e6c85dc7612c48c5e66cff1f64a44cfd" tree { parent { counter: 3 replica: 7 } position: "\x80" } }
  node { id { counter: 3 replica: 7 } node_hash: "82a81e58b6b1f0418824c2f5c4155e5246bbb69fe0dd9495bac158186ab1c572" tree { parent { counter: 5 replica: 7 } position: "\x80" children { counter: 2 replica: 7 } } }
  node { id { counter: 5 replica: 7 } node_hash: "11ed0cf5fe451494f549882c8b79948f9dd0d909a981419545d88dc339846b0a" tree { parent { counter: 1 replica: 7 } position: "\x82" children { counter: 3 replica: 7 } } }
  node { id { counter: 1 replica: 7 } tree { parent { counter: 4 } position: "\x80" children { counter: 5 replica: 7 } } }
}
