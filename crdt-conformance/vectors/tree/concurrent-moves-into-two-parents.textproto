# crdt-conformance/vectors/tree/concurrent-moves-into-two-parents.textproto (CRDT-002; schema: crdt-conformance/schema/vector.proto)
name: "tree/concurrent-moves-into-two-parents"
description: "Three people move object X at once, into layers 2, 3 and 1.  Tree ops apply in OpId order, so the move with the greatest OpId (6:1, after replica 1 renamed X at 5:1) decides X's parent however the moves arrive; the others are undone and redone around it."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Create layers and X"
    ops { create { parent { counter: 4 } position: "\x80" props { layer { common { name: "Layer 1" } } } } }
    ops { create { parent { counter: 4 } position: "\x81" props { layer { common { name: "Layer 2" } } } } }
    ops { create { parent { counter: 4 } position: "\x82" props { layer { common { name: "Layer 3" } } } } }
    ops { create { parent { counter: 1 replica: 7 } position: "\x80" props { group { common { name: "X" } } } } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 5 base_server_seq: 1 label: "Rename"
    ops { set { node { counter: 4 replica: 7 }
      paths { segments { field: 50 } segments { field: 1 } segments { field: 1 } }
      values { group { common { name: "X1" } } } } }
  }
  change {
    replica: 1 seq: 2 start_counter: 6 base_server_seq: 1 label: "Move to layer 2"
    ops { move { node { counter: 4 replica: 7 } parent { counter: 2 replica: 7 } position: "\x80" } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 5 base_server_seq: 1 label: "Move to layer 3"
    ops { move { node { counter: 4 replica: 7 } parent { counter: 3 replica: 7 } position: "\x80" } }
  }
}
replica {
  id: 3
  change {
    replica: 3 seq: 1 start_counter: 5 base_server_seq: 1 label: "Move to the back of layer 1"
    ops { move { node { counter: 4 replica: 7 } parent { counter: 1 replica: 7 } position: "\x10" } }
  }
}
deliveries { order: [1, 1, 2, 3] }
deliveries { order: [3, 2, 1, 1] }
deliveries { order: [2, 1, 3, 1] }
deliveries { order: [1, 3, 2, 1] }
expect {
  state_hash: "9fadd1da4170fec540de5f317de5170a3ca6df9521ace2292fdd51370bd75622"
  snapshot_hash: "befd49bbbfadd151e36ce329551984acc0c1d5b459464cca3dfe3dadfedd3e42"
  node {
    id { counter: 4 replica: 7 }
    node_hash: "cc454c0d2cc39e71d8d41ff0ee4bf231582bdd5dbda184e36fcb3e1a0b024d98"
    tree { parent { counter: 2 replica: 7 } position: "\x80" }
  }
  node { id { counter: 1 replica: 7 } tree { parent { counter: 4 } position: "\x80" } }
  node { id { counter: 2 replica: 7 } tree { parent { counter: 4 } position: "\x81" children { counter: 4 replica: 7 } } }
  node { id { counter: 3 replica: 7 } tree { parent { counter: 4 } position: "\x82" } }
}
