# crdt-conformance/vectors/document/custom-size-remove-vs-use.textproto (DOC-002; schema: crdt-conformance/schema/vector.proto; recorded by WTModel's DocumentSetupVectorTests)
name: "document/custom-size-remove-vs-use"
description: "Replica 1 sets the page to the custom size Card while replica 2 removes Card.  The page's geometry register keeps preset \"Card\" with no live size of that name, so it reads as Custom at the stored size (PageList); restoring the size brings the name back."
setup {
  change {
    replica: 7
    seq: 1
    start_counter: 1
    wall_time_ms: 1000000000
    label: "Change bleed"
    ops {
      create {
        parent {
          counter: 2
        }
        position: "\200U\377"
        props {
          page {
            origin {
            }
            geometry {
              preset: "Letter"
              width: 612.0
              height: 792.0
              orientation: ORIENTATION_PORTRAIT
            }
          }
        }
      }
    }
    ops {
      set {
        node {
          counter: 1
          replica: 7
        }
        paths {
          segments {
            field: 3
          }
          segments {
            field: 4
          }
        }
        values {
          page {
          }
        }
      }
    }
  }
  change {
    replica: 7
    seq: 2
    start_counter: 3
    wall_time_ms: 1000000000
    label: "Add page size"
    ops {
      element_insert {
        node {
          counter: 1
        }
        sequence {
          segments {
            field: 2
          }
          segments {
            field: 5
          }
        }
        positions: "\200\366/"
        values {
          settings {
            custom_page_sizes {
              name: "Card"
              size {
                width: 252.0
                height: 144.0
              }
            }
          }
        }
      }
    }
  }
}
replica {
  id: 1
  change {
    replica: 1
    seq: 1
    start_counter: 4
    base_server_seq: 1
    wall_time_ms: 1000000000
    label: "Change page size"
    ops {
      set {
        node {
          counter: 1
          replica: 7
        }
        paths {
          segments {
            field: 3
          }
          segments {
            field: 3
          }
        }
        values {
          page {
            geometry {
              preset: "Card"
              width: 144.0
              height: 252.0
              orientation: ORIENTATION_PORTRAIT
            }
          }
        }
      }
    }
  }
}
replica {
  id: 2
  change {
    replica: 2
    seq: 1
    start_counter: 4
    base_server_seq: 1
    wall_time_ms: 1000000000
    label: "Remove page size"
    ops {
      element_delete {
        node {
          counter: 1
        }
        elements {
          segments {
            field: 2
          }
          segments {
            field: 5
          }
          segments {
            element {
              counter: 3
              replica: 7
            }
          }
        }
        deleted: true
      }
    }
  }
}
deliveries { order: [1, 2] }
deliveries { order: [2, 1] }
