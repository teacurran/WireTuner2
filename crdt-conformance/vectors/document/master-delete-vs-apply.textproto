        }
        paths {
          segments {
            field: 4
          }
          segments {
            field: 2
          }
        }
        values {
          master_page {
            geometry {
              preset: "A5"
              width: 419.52755905511816
              height: 595.2755905511812
              orientation: ORIENTATION_PORTRAIT
            }
          }
        }
