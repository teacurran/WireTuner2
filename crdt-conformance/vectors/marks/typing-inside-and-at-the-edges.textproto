# crdt-conformance/vectors/marks/typing-inside-and-at-the-edges.textproto (CRDT-006; schema: crdt-conformance/schema/vector.proto)
name: "marks/typing-inside-and-at-the-edges"
description: "Peritext anchors: over \"abcd\", replica 1 bolds bc (start before b, end before d: an expanding attribute) and replica 3 links bc (start before b, end after c: a link never grows), while replica 2 types X inside the span, Y just after c and Z just before b.  X is bold and linked, Y is bold only (typing at the end of an expanding span extends it), Z is neither."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Type"
    ops { create { parent { counter: 4 } position: "\x80" props { test { label: "T" } } } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } chars: "abcd" } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 6 base_server_seq: 1 label: "Bold"
    ops { text_mark { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } start { char { counter: 3 replica: 7 } before: true } end { char { counter: 5 replica: 7 } before: true } value { bold: true } } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 6 base_server_seq: 1 label: "Type"
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 3 replica: 7 } right_origin { counter: 4 replica: 7 } chars: "X" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 4 replica: 7 } right_origin { counter: 5 replica: 7 } chars: "Y" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 2 replica: 7 } right_origin { counter: 3 replica: 7 } chars: "Z" } }
  }
}
replica {
  id: 3
  change {
    replica: 3 seq: 1 start_counter: 6 base_server_seq: 1 label: "Link"
    ops { text_mark { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } start { char { counter: 3 replica: 7 } before: true } end { char { counter: 4 replica: 7 } } value { url: "https://example.com" } } }
  }
}
deliveries { order: [1, 2, 3] }
deliveries { order: [3, 2, 1] }
deliveries { order: [2, 1, 3] }
expect {
  state_hash: "72143553f6ad4ee3767d754859856632f575c7a8d42ae6659d04ea0c2f77daed"
  snapshot_hash: "12790422ef965737befdc29c92c59e37e678e9d734547d4620d11896a960e6fd"
  node {
    id { counter: 1 replica: 7 }
    node_hash: ""
    text { path { segments { field: 1000 } segments { field: 9 } } text: "aZbXcYd" chars { counter: 2 replica: 7 } chars { counter: 8 replica: 2 } chars { counter: 3 replica: 7 } chars { counter: 6 replica: 2 } chars { counter: 4 replica: 7 } chars { counter: 7 replica: 2 } chars { counter: 5 replica: 7 }  runs { start: 0 length: 2 } runs { start: 2 length: 3 attributes { value { url: "https://example.com" } mark { counter: 6 replica: 3 } } attributes { value { bold: true } mark { counter: 6 replica: 1 } } } runs { start: 5 length: 1 attributes { value { bold: true } mark { counter: 6 replica: 1 } } } runs { start: 6 length: 1 } }
  }
}
