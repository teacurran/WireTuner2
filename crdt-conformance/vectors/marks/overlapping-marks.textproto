# crdt-conformance/vectors/marks/overlapping-marks.textproto (CRDT-006; schema: crdt-conformance/schema/vector.proto)
name: "marks/overlapping-marks"
description: "Over \"abcdef\": font A on a-d and font B on c-f overlap, and in c-d the mark with the greater OpId (B) wins; bold covers everything and stacks with them; OpenType features stack by tag (ss01 on a-c with liga everywhere) while two liga marks resolve by OpId (state 2 on e-f); a later bold=false clears bold on f (a value holding its default is left out of the runs)."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Type"
    ops { create { parent { counter: 4 } position: "\x80" props { test { label: "T" } } } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } chars: "abcdef" } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 8 base_server_seq: 1 label: "Format"
    ops { text_mark { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } start { char { counter: 2 replica: 7 } before: true } end { char { counter: 6 replica: 7 } before: true } value { font_family: "A" } } }
    ops { text_mark { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } start { before: true } end {  } value { bold: true } } }
    ops { text_mark { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } start { char { counter: 2 replica: 7 } before: true } end { char { counter: 5 replica: 7 } before: true } value { feature { tag: "ss01" state: 1 } } } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 8 base_server_seq: 1 label: "Format"
    ops { text_mark { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } start { char { counter: 4 replica: 7 } before: true } end {  } value { font_family: "B" } } }
    ops { text_mark { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } start { before: true } end {  } value { feature { tag: "liga" state: 1 } } } }
    ops { text_mark { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } start { char { counter: 6 replica: 7 } before: true } end {  } value { feature { tag: "liga" state: 2 } } } }
    ops { text_mark { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } start { char { counter: 7 replica: 7 } before: true } end {  } value { bold: false } } }
  }
}
