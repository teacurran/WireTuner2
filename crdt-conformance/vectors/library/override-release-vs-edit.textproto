# crdt-conformance/vectors/library/override-release-vs-edit.textproto (LIB-028; schema: crdt-conformance/schema/vector.proto)
name: "library/override-release-vs-edit"
description: "Release (a group holding the artwork as resolved -- the red override written into the copy's fill -- then the instance deleted) against a concurrent recolor of the override: edit vs delete on the instance; the released copy keeps the red it was made with, and the deleted instance keeps the blue override for Restore."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Symbol with an instance"
    ops { create { parent { counter: 4 } position: "\x80" props { layer { common { name: "Layer 1" } visible: true printing: true } } } }
    ops { create { parent { counter: 7 } position: "\x80" props { symbol { common { name: "Badge" } } } } }
    ops { create { parent { counter: 2 replica: 7 } position: "\x80" props { rect { common { name: "Star" } size { width: 10 height: 10 } } } } }
    ops { create { parent { counter: 1 replica: 7 } position: "\x80" props { instance { symbol { id { counter: 2 replica: 7 } } } } } }
  }
  change {
    replica: 7 seq: 2 start_counter: 5 label: "Override fill"
    ops { element_insert { node { counter: 4 replica: 7 } sequence { segments { field: 153 } segments { field: 3 } } positions: ["\x80"] values { instance { overrides { master_node { counter: 3 replica: 7 } property: OVERRIDE_PROPERTY_FILL fill { inline { rgb { r: 1 } } } } } } } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 6 base_server_seq: 2 label: "Release Instance"
    ops { create { parent { counter: 1 replica: 7 } position: "\x81" props { group { kind: GROUP_KIND_GROUP } } } }
    ops { create { parent { counter: 6 replica: 1 } position: "\x80" props { rect { common { name: "Star" } size { width: 10 height: 10 } } } } }
    ops { element_insert { node { counter: 7 replica: 1 } sequence { segments { field: 21 } segments { field: 4 } segments { field: 1 } } positions: ["\x80"] values { rect { appearance { fills { settings { kind: FILL_KIND_BASIC basic { color { inline { rgb { r: 1 } } } } } } } } } } }
    ops { set_deleted { node { counter: 4 replica: 7 } deleted: true } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 6 base_server_seq: 2 label: "Override fill"
    ops { set { node { counter: 4 replica: 7 } paths { segments { field: 153 } segments { field: 3 } segments { element { counter: 5 replica: 7 } } segments { field: 5 } } values { instance { overrides { fill { inline { rgb { b: 1 } } } } } } } }
  }
}
deliveries { order: [1, 2] }
deliveries { order: [2, 1] }
expect {
  state_hash: "ba420f663a70addc02f124374e3e43de0a484d5149e6c743879de1429c0117b7"
  snapshot_hash: "009b481ede4469b85b659eb02dd541215f710ace6c947ae301dd591341ad2326"
  node {
    id { counter: 4 replica: 7 }
    tree { parent { counter: 1 replica: 7 } position: "\x80" deleted: true }
    sequence { path { segments { field: 153 } segments { field: 3 } } elements { counter: 5 replica: 7 } }
    register { path { segments { field: 153 } segments { field: 3 } segments { element { counter: 5 replica: 7 } } segments { field: 5 } } value { instance { overrides { fill { inline { rgb { b: 1 } } } } } } op { counter: 6 replica: 2 } losing { counter: 5 replica: 7 } }
  }
  node {
    id { counter: 7 replica: 1 }
    tree { parent { counter: 6 replica: 1 } position: "\x80" }
    register { path { segments { field: 21 } segments { field: 4 } segments { field: 1 } segments { element { counter: 8 replica: 1 } } segments { field: 3 } segments { field: 2 } segments { field: 1 } } value { rect { appearance { fills { settings { basic { color { inline { rgb { r: 1 } } } } } } } } } op { counter: 8 replica: 1 } }
  }
}
