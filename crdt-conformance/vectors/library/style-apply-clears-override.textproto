# crdt-conformance/vectors/library/style-apply-clears-override.textproto (LIB-019; schema: crdt-conformance/schema/vector.proto)
name: "library/style-apply-clears-override"
description: "Applying a style clears the object's overrides in the categories it governs with the clear-to-unset SetFields form: one SetFields lists CommonProps.style with the reference and CommonProps.halftone with no value in values, which writes the halftone register unset under the op's id.  Replica 2 concurrently overrides the halftone at 4:2; replica 1's apply (after a rename) is 5:1, so the clear wins by LWW like any write and the override and the create's value are retained as losing writes for the review sheet."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Layer, style and rectangle"
    ops { create { parent { counter: 4 } position: "\x80" props { layer { common { name: "Layer 1" } } } } }
    ops { create { parent { counter: 6 } position: "\x80" props { style { common { name: "Callout" } kind: STYLE_KIND_GRAPHIC behavior { fills: true strokes: true effects: true halftone: true } } } } }
    ops { create { parent { counter: 1 replica: 7 } position: "\x80" props { rect { common { halftone { frequency: 85 } } size { width: 10 height: 10 } } } } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 4 base_server_seq: 1 label: "Rename style"
    ops { set { node { counter: 2 replica: 7 } paths { segments { field: 154 } segments { field: 1 } segments { field: 1 } } values { style { common { name: "Note" } } } } }
  }
  change {
    replica: 1 seq: 2 start_counter: 5 base_server_seq: 1 label: "Apply style Note"
    ops { set { node { counter: 3 replica: 7 }
      paths { segments { field: 21 } segments { field: 1 } segments { field: 7 } }
      paths { segments { field: 21 } segments { field: 1 } segments { field: 11 } }
      values { rect { common { style { id { counter: 2 replica: 7 } } } } } } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 4 base_server_seq: 1 label: "Halftone"
    ops { set { node { counter: 3 replica: 7 } paths { segments { field: 21 } segments { field: 1 } segments { field: 11 } } values { rect { common { halftone { frequency: 120 } } } } } }
  }
}
deliveries { order: [1, 1, 2] }
deliveries { order: [1, 2, 1] }
deliveries { order: [2, 1, 1] }
expect {
  state_hash: "bfdaec5e9cb480ee1ec18dc550f2e4f8491881545c793f5ed939e622c1f78635"
  snapshot_hash: "a5def4b6e82638e059ffb01bc0d8d019dcb762d5529835c6c8d814990ca2a62d"
  node {
    id { counter: 3 replica: 7 }
    register { path { segments { field: 21 } segments { field: 1 } segments { field: 7 } } value { rect { common { style { id { counter: 2 replica: 7 } } } } } op { counter: 5 replica: 1 } }
    register { path { segments { field: 21 } segments { field: 1 } segments { field: 11 } } op { counter: 5 replica: 1 } losing { counter: 3 replica: 7 } losing { counter: 4 replica: 2 } }
  }
}
