# crdt-conformance/vectors/type/concurrent-typing-at-one-anchor.textproto (TYPE-004; schema: crdt-conformance/schema/vector.proto)
name: "type/concurrent-typing-at-one-anchor"
description: "Creating text, Merge semantics, Characters: three replicas type at the same anchor of \"ab\" (between a and b) -- \"hello \" typed one character per keystroke (each character's left origin the one before), \"world\" as one insert and \"!\".  Each run stays contiguous and the runs sort by their first character's OpId, never interleaving letters."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Type"
    ops { create { parent { counter: 4 } position: "\x80" props { test { label: "T" } } } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } chars: "ab" } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 4 base_server_seq: 1 label: "Type"
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 2 replica: 7 } right_origin { counter: 3 replica: 7 } chars: "h" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 4 replica: 1 } right_origin { counter: 3 replica: 7 } chars: "e" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 5 replica: 1 } right_origin { counter: 3 replica: 7 } chars: "l" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 6 replica: 1 } right_origin { counter: 3 replica: 7 } chars: "l" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 7 replica: 1 } right_origin { counter: 3 replica: 7 } chars: "o" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 8 replica: 1 } right_origin { counter: 3 replica: 7 } chars: " " } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 4 base_server_seq: 1 label: "Type"
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 2 replica: 7 } right_origin { counter: 3 replica: 7 } chars: "world" } }
  }
}
replica {
  id: 3
  change {
    replica: 3 seq: 1 start_counter: 4 base_server_seq: 1 label: "Type"
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 2 replica: 7 } right_origin { counter: 3 replica: 7 } chars: "!" } }
  }
}
deliveries { order: [1, 2, 3] }
deliveries { order: [1, 3, 2] }
deliveries { order: [2, 1, 3] }
deliveries { order: [2, 3, 1] }
deliveries { order: [3, 1, 2] }
deliveries { order: [3, 2, 1] }
