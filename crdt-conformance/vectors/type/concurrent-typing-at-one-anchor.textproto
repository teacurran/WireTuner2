  state_hash: "ea286f3acae5625f236955cfbf2d15489b3f2558f70ceb7fd66a36cfa7e4d1d0"
  snapshot_hash: "9489d2201061a5e52be2a1838c90fab9262b15126e3f5318492bb5c25d4dae68"
  node {
    id { counter: 1 replica: 7 }
    node_hash: ""
    text { path { segments { field: 1000 } segments { field: 9 } } text: "ahello world!b" chars { counter: 2 replica: 7 } chars { counter: 4 replica: 1 } chars { counter: 5 replica: 1 } chars { counter: 6 replica: 1 } chars { counter: 7 replica: 1 } chars { counter: 8 replica: 1 } chars { counter: 9 replica: 1 } chars { counter: 4 replica: 2 } chars { counter: 5 replica: 2 } chars { counter: 6 replica: 2 } chars { counter: 7 replica: 2 } chars { counter: 8 replica: 2 } chars { counter: 4 replica: 3 } chars { counter: 3 replica: 7 }  runs { start: 0 length: 14 } }
