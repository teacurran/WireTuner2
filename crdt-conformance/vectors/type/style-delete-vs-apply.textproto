# crdt-conformance/vectors/type/style-delete-vs-apply.textproto (TYPE-004; schema: crdt-conformance/schema/vector.proto)
name: "type/style-delete-vs-apply"
description: "Text styles, Merge semantics, Delete vs. apply and Apply vs. edit text: replica 1 deletes style S while replica 2 applies it to the paragraph \"ab\" (the paragraph's style reference with its cache, the governed alignment register, and a covering font mark over the paragraph) and replica 3 concurrently sets font Mono on a.  The deleted style stays in the tree, restorable, and the paragraph keeps the dangling reference with its cache; on a the Mono mark (8:3) is newer than the style's covering mark (7:2) and shows, while b reads the style's font."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Create"
    ops { create { parent { counter: 4 } position: "\x80" props { style { common { name: "Heading" } } } } }
    ops { create { parent { counter: 4 } position: "\x90" props { text { common { name: "T" } } } } }
    ops { text_insert { node { counter: 2 replica: 7 } text { segments { field: 130 } segments { field: 2 } } chars: "ab" } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 5 base_server_seq: 1 label: "Delete style"
    ops { set_deleted { node { counter: 1 replica: 7 } deleted: true } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 5 base_server_seq: 1 label: "Apply style Heading"
    ops { set { node { counter: 2 replica: 7 } paths { segments { field: 130 } segments { field: 8 } segments { field: 17 } } values { text { tail_paragraph { style { id { counter: 1 replica: 7 } cached: "Heading" } } } } } }
    ops { set { node { counter: 2 replica: 7 } paths { segments { field: 130 } segments { field: 8 } segments { field: 1 } } values { text { tail_paragraph { alignment: ALIGNMENT_CENTER } } } } }
    ops { text_mark { node { counter: 2 replica: 7 } text { segments { field: 130 } segments { field: 2 } } start { before: true } end { } value { font_family: "Heading Sans" } } }
  }
}
replica {
  id: 3
  change {
    replica: 3 seq: 1 start_counter: 8 base_server_seq: 1 label: "Font"
    ops { text_mark { node { counter: 2 replica: 7 } text { segments { field: 130 } segments { field: 2 } } start { char { counter: 3 replica: 7 } before: true } end { char { counter: 4 replica: 7 } before: true } value { font_family: "Mono" } } }
  }
}
deliveries { order: [1, 2, 3] }
deliveries { order: [1, 3, 2] }
deliveries { order: [2, 1, 3] }
deliveries { order: [2, 3, 1] }
deliveries { order: [3, 1, 2] }
deliveries { order: [3, 2, 1] }
expect {
  state_hash: "7456c5ad9fcfcf7acefd1658a6d15b38c4fa52ff8e807a677513a98f682131ae"
  snapshot_hash: "af6b00f3404fdddd45f010c658522daf6d8a513dcf6dafe3dddc3aec3af79db6"
  node {
    id { counter: 1 replica: 7 }
    node_hash: ""
    tree { parent { counter: 4 } position: "\x80" deleted: true }
  }
  node {
    id { counter: 2 replica: 7 }
    node_hash: ""
    register { path { segments { field: 130 } segments { field: 8 } segments { field: 17 } } value { text { tail_paragraph { style { id { counter: 1 replica: 7 } cached: "Heading" } } } } op { counter: 5 replica: 2 } }
    register { path { segments { field: 130 } segments { field: 8 } segments { field: 1 } } value { text { tail_paragraph { alignment: ALIGNMENT_CENTER } } } op { counter: 6 replica: 2 } }
    text { path { segments { field: 130 } segments { field: 2 } } text: "ab" chars { counter: 3 replica: 7 } chars { counter: 4 replica: 7 }  runs { start: 0 length: 1 attributes { value { font_family: "Mono" } mark { counter: 8 replica: 3 } }} runs { start: 1 length: 1 attributes { value { font_family: "Heading Sans" } mark { counter: 7 replica: 2 } }} }
  }
}
