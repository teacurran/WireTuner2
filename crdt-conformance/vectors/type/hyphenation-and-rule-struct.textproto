      op { counter: 2 replica: 3 }
      losing { counter: 1 replica: 7 }
    }
    register {
      path { segments { field: 130 } segments { field: 8 } segments { field: 10 } segments { field: 2 } }
      value { text { tail_paragraph { hyphenation { language: "fr-CA" } } } }
      op { counter: 2 replica: 3 }
      losing { counter: 1 replica: 7 }
      losing { counter: 2 replica: 2 }
    }
    register {
