deliveries { order: [2, 4, 1, 3] }
deliveries { order: [2, 4, 3, 1] }
deliveries { order: [3, 1, 2, 4] }
deliveries { order: [3, 1, 4, 2] }
deliveries { order: [3, 2, 1, 4] }
deliveries { order: [3, 2, 4, 1] }
deliveries { order: [3, 4, 1, 2] }
deliveries { order: [3, 4, 2, 1] }
deliveries { order: [4, 1, 2, 3] }
