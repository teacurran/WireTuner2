# crdt-conformance/vectors/type/link-vs-typing-at-each-edge.textproto (TYPE-004; schema: crdt-conformance/schema/vector.proto)
name: "type/link-vs-typing-at-each-edge"
description: "Creating text, Merge semantics, Marks: a link never grows.  Over \"abcd\" replica 1 links bc (start before b, end after c) while replica 2 types Z at the start edge, replica 3 types Y at the end edge (between c and d) and replica 4 types X inside.  Only X, between the anchored characters, is linked."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Type"
    ops { create { parent { counter: 4 } position: "\x80" props { test { label: "T" } } } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } chars: "abcd" } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 6 base_server_seq: 1 label: "Link"
    ops { text_mark { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } start { char { counter: 3 replica: 7 } before: true } end { char { counter: 4 replica: 7 } } value { url: "https://example.com" } } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 6 base_server_seq: 1 label: "Type"
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 2 replica: 7 } right_origin { counter: 3 replica: 7 } chars: "Z" } }
  }
}
replica {
  id: 3
  change {
    replica: 3 seq: 1 start_counter: 6 base_server_seq: 1 label: "Type"
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 4 replica: 7 } right_origin { counter: 5 replica: 7 } chars: "Y" } }
  }
}
replica {
  id: 4
  change {
    replica: 4 seq: 1 start_counter: 6 base_server_seq: 1 label: "Type"
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 3 replica: 7 } right_origin { counter: 4 replica: 7 } chars: "X" } }
  }
}
deliveries { order: [1, 2, 3, 4] }
deliveries { order: [1, 2, 4, 3] }
deliveries { order: [1, 3, 2, 4] }
deliveries { order: [1, 3, 4, 2] }
deliveries { order: [1, 4, 2, 3] }
deliveries { order: [1, 4, 3, 2] }
deliveries { order: [2, 1, 3, 4] }
deliveries { order: [2, 1, 4, 3] }
deliveries { order: [2, 3, 1, 4] }
deliveries { order: [2, 3, 4, 1] }
deliveries { order: [2, 4, 1, 3] }
deliveries { order: [2, 4, 3, 1] }
deliveries { order: [3, 1, 2, 4] }
deliveries { order: [3, 1, 4, 2] }
deliveries { order: [3, 2, 1, 4] }
deliveries { order: [3, 2, 4, 1] }
deliveries { order: [3, 4, 1, 2] }
deliveries { order: [3, 4, 2, 1] }
deliveries { order: [4, 1, 2, 3] }
deliveries { order: [4, 1, 3, 2] }
deliveries { order: [4, 2, 1, 3] }
deliveries { order: [4, 2, 3, 1] }
deliveries { order: [4, 3, 1, 2] }
deliveries { order: [4, 3, 2, 1] }
