    register { path { segments { field: 1000 } segments { field: 9 } segments { element { counter: 8 replica: 1 } } segments { field: 6 } segments { field: 4 } } value { test { text { chars { paragraph { left_indent: 10 } } } } } op { counter: 9 replica: 1 } }
    register { path { segments { field: 1000 } segments { field: 9 } segments { element { counter: 4 replica: 7 } } segments { field: 6 } segments { field: 1 } } value { test { text { chars { paragraph { alignment: 2 } } } } } op { counter: 8 replica: 2 } losing { counter: 7 replica: 7 } }
