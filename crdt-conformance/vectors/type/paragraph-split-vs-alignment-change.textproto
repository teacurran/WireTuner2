# crdt-conformance/vectors/type/paragraph-split-vs-alignment-change.textproto (TYPE-004; schema: crdt-conformance/schema/vector.proto)
name: "type/paragraph-split-vs-alignment-change"
description: "Creating text, Merge semantics, Paragraphs: in \"ab\\ncd\" (the first paragraph centred, alignment 1, left indent 10) replica 1 types Return after a, copying the terminator's alignment and indent onto the new newline as the typist saw them, while replica 2 sets the paragraph's alignment to 2 and replica 3 its left indent to 20, both on the original terminator.  The first half keeps the copy (1, 10); the second half, still ended by the original newline, has 2 and 20."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Type"
    ops { create { parent { counter: 4 } position: "\x80" props { test { label: "T" } } } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } chars: "ab\ncd" } }
    ops { set { node { counter: 1 replica: 7 } paths { segments { field: 1000 } segments { field: 9 } segments { element { counter: 4 replica: 7 } } segments { field: 6 } } values { test { text { chars { paragraph { alignment: 1 left_indent: 10 } } } } } } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 8 base_server_seq: 1 label: "Split paragraph"
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 2 replica: 7 } right_origin { counter: 3 replica: 7 } chars: "\n" } }
    ops { set { node { counter: 1 replica: 7 } paths { segments { field: 1000 } segments { field: 9 } segments { element { counter: 8 replica: 1 } } segments { field: 6 } } values { test { text { chars { paragraph { alignment: 1 left_indent: 10 } } } } } } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 8 base_server_seq: 1 label: "Align"
    ops { set { node { counter: 1 replica: 7 } paths { segments { field: 1000 } segments { field: 9 } segments { element { counter: 4 replica: 7 } } segments { field: 6 } segments { field: 1 } } values { test { text { chars { paragraph { alignment: 2 } } } } } } }
  }
}
replica {
  id: 3
  change {
    replica: 3 seq: 1 start_counter: 8 base_server_seq: 1 label: "Indent"
    ops { set { node { counter: 1 replica: 7 } paths { segments { field: 1000 } segments { field: 9 } segments { element { counter: 4 replica: 7 } } segments { field: 6 } segments { field: 4 } } values { test { text { chars { paragraph { left_indent: 20 } } } } } } }
  }
}
deliveries { order: [1, 2, 3] }
deliveries { order: [1, 3, 2] }
deliveries { order: [2, 1, 3] }
deliveries { order: [2, 3, 1] }
deliveries { order: [3, 1, 2] }
deliveries { order: [3, 2, 1] }
