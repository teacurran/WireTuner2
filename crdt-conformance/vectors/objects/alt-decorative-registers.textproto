# crdt-conformance/vectors/objects/alt-decorative-registers.textproto (OBJ-040; schema: crdt-conformance/schema/vector.proto)
name: "objects/alt-decorative-registers"
description: "Names and notes, Merge semantics: CommonProps.alt and .decorative are independent LWW registers.  A rectangle has the alt text Logo.  Replica 1 writes Company logo and replica 2 Brand mark at once; replica 3 ticks Decorative; replica 4 deletes the rectangle.  The alt text is one register won whole by the greater OpId (replica 2), the other retained as a loser, not TEXT-merged; Decorative stands beside it without touching the text; the edits of the deleted node are kept on the tombstone."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Create"
    ops { create { parent { counter: 4 } position: "\x80" props { layer { common { name: "Layer 1" } } } } }
    ops { create { parent { counter: 1 replica: 7 } position: "\x80" props { rect { common { name: "Badge" alt: "Logo" } size { width: 40 height: 20 } } } } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 3 base_server_seq: 1 label: "Alt Text"
    ops { set { node { counter: 2 replica: 7 }
      paths { segments { field: 21 } segments { field: 1 } segments { field: 9 } }
      values { rect { common { alt: "Company logo" } } } } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 3 base_server_seq: 1 label: "Alt Text"
    ops { set { node { counter: 2 replica: 7 }
      paths { segments { field: 21 } segments { field: 1 } segments { field: 9 } }
      values { rect { common { alt: "Brand mark" } } } } }
  }
}
replica {
  id: 3
  change {
    replica: 3 seq: 1 start_counter: 3 base_server_seq: 1 label: "Decorative"
    ops { set { node { counter: 2 replica: 7 }
      paths { segments { field: 21 } segments { field: 1 } segments { field: 10 } }
      values { rect { common { decorative: true } } } } }
  }
}
replica {
  id: 4
  change {
    replica: 4 seq: 1 start_counter: 3 base_server_seq: 1 label: "Delete"
    ops { set_deleted { node { counter: 2 replica: 7 } deleted: true } }
  }
}
deliveries { order: [1, 2, 3, 4] }
deliveries { order: [4, 3, 2, 1] }
deliveries { order: [2, 4, 1, 3] }
expect {
  state_hash: "8af1a5c6cb412f0e2463a5e466b9342c63787dce6062c2de1059d55a7624248b"
  snapshot_hash: "116c50ed09487df9ba867c5753b1e3024d952b255d8eff692fcce5f2cb1e95b5"
  node {
    id { counter: 2 replica: 7 }
    node_hash: "1cec6091447c50a18ef708080f127f03f246e85fe4159e3ebce7fdb1b25412ad"
    tree { parent { counter: 1 replica: 7 } position: "\x80" deleted: true }
    register { path { segments { field: 21 } segments { field: 1 } segments { field: 9 } } value { rect { common { alt: "Brand mark" } } } op { counter: 3 replica: 2 } losing { counter: 2 replica: 7 } losing { counter: 3 replica: 1 } }
    register { path { segments { field: 21 } segments { field: 1 } segments { field: 10 } } value { rect { common { decorative: true } } } op { counter: 3 replica: 3 } }
  }
}
