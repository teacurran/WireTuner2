# crdt-conformance/vectors/web/link-mark-typing-inside-and-after.textproto (WEB-001; schema: crdt-conformance/schema/vector.proto)
name: "web/link-mark-typing-inside-and-after"
description: "Replica 1 links b-d of 'abcdef' (end after d, a non-growing mark); replica 2 types X inside the range (after c) and Y just after d.  X is covered by the link, Y is not: the mark grows over text typed inside it but not at its end."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Type"
    ops { create { parent { counter: 4 } position: "\x80" props { text { common { name: "T" } } } } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 130 } segments { field: 2 } } chars: "abcdef" } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 8 base_server_seq: 1 label: "Link"
    ops { text_mark { node { counter: 1 replica: 7 } text { segments { field: 130 } segments { field: 2 } } start { char { counter: 3 replica: 7 } before: true } end { char { counter: 5 replica: 7 } } value { link: "https://a.example" } } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 8 base_server_seq: 1 label: "Type"
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 130 } segments { field: 2 } } left_origin { counter: 4 replica: 7 } right_origin { counter: 5 replica: 7 } chars: "X" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 130 } segments { field: 2 } } left_origin { counter: 5 replica: 7 } right_origin { counter: 6 replica: 7 } chars: "Y" } }
  }
}
deliveries { order: [1, 2] }
deliveries { order: [2, 1] }
expect {
  state_hash: "fc41f472dabf2fcd914d60b8373e586ac6dedd368f7461d94187ff3e9125a757"
  snapshot_hash: "eb308ec6802384404a61ba572c4e518e81cbee31aa3a38c95c927d6f1752eb51"
  node {
    id { counter: 1 replica: 7 }
    node_hash: ""
    text { path { segments { field: 130 } segments { field: 2 } } text: "abcXdYef" chars { counter: 2 replica: 7 } chars { counter: 3 replica: 7 } chars { counter: 4 replica: 7 } chars { counter: 8 replica: 2 } chars { counter: 5 replica: 7 } chars { counter: 9 replica: 2 } chars { counter: 6 replica: 7 } chars { counter: 7 replica: 7 } runs { start: 0 length: 1 } runs { start: 1 length: 4 attributes { value { link: "https://a.example" } mark { counter: 8 replica: 1 } } } runs { start: 5 length: 3 } }
  }
}
