# crdt-conformance/vectors/web/html-settings-field-edits-and-delete.textproto (WEB-007; schema: crdt-conformance/schema/vector.proto)
name: "web/html-settings-field-edits-and-delete"
description: "HtmlSetting elements are STRUCTs in a SEQUENCE.  Replica 1 sets layout to POSITIONED_OBJECTS and replica 2 sets font_mode to OUTLINES on the Web setting (2:7) while replica 3 deletes it: both edits apply and are retained on the tombstone, which a Restore brings back edited."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Add HTML setting"
    ops { element_insert { node { counter: 1 replica: 0 } sequence { segments { field: 2 } segments { field: 60 } } positions: ["\x80", "\x81"] values { settings { html_settings { name: "Default" } html_settings { name: "Web" layout: HTML_LAYOUT_WHOLE_PAGES } } } } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 3 base_server_seq: 1 label: "Change HTML setting"
    ops { set { node { counter: 1 replica: 0 }
      paths { segments { field: 2 } segments { field: 60 } segments { element { counter: 2 replica: 7 } } segments { field: 4 } }
      values { settings { html_settings { id { counter: 2 replica: 7 } layout: HTML_LAYOUT_POSITIONED_OBJECTS } } } } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 3 base_server_seq: 1 label: "Change HTML setting"
    ops { set { node { counter: 1 replica: 0 }
      paths { segments { field: 2 } segments { field: 60 } segments { element { counter: 2 replica: 7 } } segments { field: 10 } }
      values { settings { html_settings { id { counter: 2 replica: 7 } font_mode: HTML_FONT_MODE_OUTLINES } } } } }
  }
}
replica {
  id: 3
  change {
    replica: 3 seq: 1 start_counter: 3 base_server_seq: 1 label: "Delete HTML setting"
    ops { element_delete { node { counter: 1 replica: 0 } elements { segments { field: 2 } segments { field: 60 } segments { element { counter: 2 replica: 7 } } } deleted: true } }
  }
}
deliveries { order: [1, 2, 3] }
deliveries { order: [3, 2, 1] }
expect {
  state_hash: "62d809253be6d3820994f69fc642f25a08bd7e3cae088cc00e5a07770d803d48"
  snapshot_hash: "32ba8fc64ee3f9bae7c62baecc2b33315b62520bac1097b55c20e199f7d4c327"
  node {
    id { counter: 1 replica: 0 }
    node_hash: ""
    sequence { path { segments { field: 2 } segments { field: 60 } } elements { counter: 1 replica: 7 } deleted { counter: 2 replica: 7 } }
    register { path { segments { field: 2 } segments { field: 60 } segments { element { counter: 2 replica: 7 } } segments { field: 4 } } value { settings { html_settings { layout: HTML_LAYOUT_POSITIONED_OBJECTS } } } op { counter: 3 replica: 1 } losing { counter: 2 replica: 7 } }
    register { path { segments { field: 2 } segments { field: 60 } segments { element { counter: 2 replica: 7 } } segments { field: 10 } } value { settings { html_settings { font_mode: HTML_FONT_MODE_OUTLINES } } } op { counter: 3 replica: 2 } }
  }
}
