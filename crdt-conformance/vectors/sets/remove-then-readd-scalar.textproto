# crdt-conformance/vectors/sets/remove-then-readd-scalar.textproto (CRDT-007; schema: crdt-conformance/schema/vector.proto)
name: "sets/remove-then-readd-scalar"
description: "Replica 1 removes red and blue and adds both back.  Replica 2, concurrently, removes red: it never saw the re-add, so red stays.  Replica 3 saw the re-add (base_server_seq 4) and removes blue: that remove observed every add of blue, so blue is gone.  A packed repeated uint32 set loses 2 and keeps 1 and 3."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Create"
    ops { create { parent { counter: 4 } position: "\x80" props { test { label: "T" } } } }
  }
  change {
    replica: 7 seq: 2 start_counter: 2 label: "Tag"
    ops { set_add { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 3 } } values { test { tags: "red" tags: "blue" } } } }
    ops { set_add { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 4 } } values { test { codes: [1, 2, 3] } } } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 4 base_server_seq: 2 server_seq: 3 label: "Untag"
    ops { set_remove { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 3 } } values { test { tags: "red" tags: "blue" } } } }
    ops { set_remove { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 4 } } values { test { codes: 2 } } } }
  }
  change {
    replica: 1 seq: 2 start_counter: 6 base_server_seq: 2 server_seq: 4 label: "Tag again"
    ops { set_add { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 3 } } values { test { tags: "red" tags: "blue" } } } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 4 base_server_seq: 2 server_seq: 5 label: "Untag red"
    ops { set_remove { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 3 } } values { test { tags: "red" } } } }
  }
}
replica {
  id: 3
  change {
    replica: 3 seq: 1 start_counter: 7 base_server_seq: 4 server_seq: 6 label: "Untag blue"
    ops { set_remove { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 3 } } values { test { tags: "blue" } } } }
  }
}
deliveries { order: [1, 1, 2, 3] }
deliveries { order: [3, 2, 1, 1] }
deliveries { order: [2, 1, 3, 1] }
expect {
  state_hash: "2cd6ff888f1bce2be4806b85b3623d00bdbeb92e2e036542c5ff16eacc2eb67c"
  node {
    id { counter: 1 replica: 7 }
    node_hash: "beb725ba355e66374773673430bc13570b60b1ba766bfdf30396789833c450b4"
    set { path { segments { field: 1000 } segments { field: 3 } } members { test { tags: "red" } } }
    set { path { segments { field: 1000 } segments { field: 4 } } members { test { codes: [3, 1] } } }
  }
}
