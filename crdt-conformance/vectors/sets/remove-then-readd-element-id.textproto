# crdt-conformance/vectors/sets/remove-then-readd-element-id.textproto (CRDT-007; schema: crdt-conformance/schema/vector.proto)
name: "sets/remove-then-readd-element-id"
description: "Replica 1 removes point 7:1 and adds it back in its next change.  Replica 2 removes 7:1 concurrently with the re-add (base_server_seq 2): it observed only the original add, so the re-added point stays.  Point 8:1, removed by replica 3 which saw everything (base_server_seq 4), is gone.  A change the server has not sequenced yet (replica 2) still removes what its causal past holds."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Create"
    ops { create { parent { counter: 4 } position: "\x80" props { test { label: "T" } } } }
  }
  change {
    replica: 7 seq: 2 start_counter: 2 label: "Choose"
    ops { set_add { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 5 } } values { test { points { counter: 7 replica: 1 } points { counter: 8 replica: 1 } } } } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 3 base_server_seq: 2 server_seq: 3 label: "Unchoose"
    ops { set_remove { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 5 } } values { test { points { counter: 7 replica: 1 } } } } }
  }
  change {
    replica: 1 seq: 2 start_counter: 4 base_server_seq: 2 server_seq: 4 label: "Choose again"
    ops { set_add { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 5 } } values { test { points { counter: 7 replica: 1 } } } } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 3 base_server_seq: 2 label: "Unchoose"
    ops { set_remove { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 5 } } values { test { points { counter: 7 replica: 1 } } } } }
  }
}
replica {
  id: 3
  change {
    replica: 3 seq: 1 start_counter: 5 base_server_seq: 4 server_seq: 5 label: "Unchoose 8:1"
    ops { set_remove { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 5 } } values { test { points { counter: 8 replica: 1 } } } } }
  }
}
deliveries { order: [1, 1, 2, 3] }
deliveries { order: [3, 2, 1, 1] }
deliveries { order: [2, 1, 3, 1] }
expect {
  state_hash: "188205dc42741652898a28729d8c79d7886c78c26e0182d1f98acacc45208667"
  node {
    id { counter: 1 replica: 7 }
    node_hash: "6a51167d7cbada3e2ef2c60d5715bc756d22b2067dec601fcc595af6a592d79b"
    set { path { segments { field: 1000 } segments { field: 5 } } members { test { points { counter: 7 replica: 1 } } } }
  }
}
