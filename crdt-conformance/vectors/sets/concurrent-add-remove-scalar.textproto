# crdt-conformance/vectors/sets/concurrent-add-remove-scalar.textproto (CRDT-007; schema: crdt-conformance/schema/vector.proto)
name: "sets/concurrent-add-remove-scalar"
description: "Add-wins over string members.  red and blue were added (server_seq 2).  Replica 2 removes both (base_server_seq 2, so it observed those adds) while replica 1 adds red again.  The remove has the greater OpId (3:2 > 3:1) but did not observe replica 1's add, so red stays (its one live tag is 3:1) and blue, removed without a concurrent add, is gone."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Create"
    ops { create { parent { counter: 4 } position: "\x80" props { test { label: "T" } } } }
  }
  change {
    replica: 7 seq: 2 start_counter: 2 label: "Tag"
    ops { set_add { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 3 } } values { test { tags: "red" tags: "blue" } } } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 3 base_server_seq: 2 server_seq: 4 label: "Tag red"
    ops { set_add { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 3 } } values { test { tags: "red" } } } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 3 base_server_seq: 2 server_seq: 3 label: "Untag"
    ops { set_remove { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 3 } } values { test { tags: "red" tags: "blue" } } } }
  }
}
deliveries { order: [1, 2] }
deliveries { order: [2, 1] }
expect {
  state_hash: "a4b1ef7367e5be2a563254081011368e623c08f8972fb38e51ca873dadb24cdc"
  snapshot_hash: "4d734bc284a6d170b3ece982cb1a8b4307352fbd77bcfd09a19ef5130a07590a"
  node {
    id { counter: 1 replica: 7 }
    node_hash: "5d39debafc58cbc3db2443bb202baf807153f96692d502077d5765da6f2b0009"
    set { path { segments { field: 1000 } segments { field: 3 } } members { test { tags: "red" } } }
  }
}
