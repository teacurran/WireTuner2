# crdt-conformance/vectors/sets/concurrent-add-remove-element-id.textproto (CRDT-007; schema: crdt-conformance/schema/vector.proto)
name: "sets/concurrent-add-remove-element-id"
description: "Add-wins over ElementId members (as live-effect point sets are) and OpId members, compared by value.  Replica 2 removes point 7:1 and node 1:7, observing their adds; replica 1 concurrently adds point 7:1 again (written with its fields in the other order, the same value) and node 9:9.  7:1 stays, 8:1 stays, node 1:7 is gone and 9:9 is added."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Create"
    ops { create { parent { counter: 4 } position: "\x80" props { test { label: "T" } } } }
  }
  change {
    replica: 7 seq: 2 start_counter: 2 label: "Choose"
    ops { set_add { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 5 } } values { test { points { counter: 7 replica: 1 } points { counter: 8 replica: 1 } } } } }
    ops { set_add { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 6 } } values { test { nodes { counter: 1 replica: 7 } } } } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 4 base_server_seq: 2 server_seq: 4 label: "Choose again"
    ops { set_add { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 5 } } values { test { points { replica: 1 counter: 7 } } } } }
    ops { set_add { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 6 } } values { test { nodes { counter: 9 replica: 9 } } } } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 4 base_server_seq: 2 server_seq: 3 label: "Unchoose"
    ops { set_remove { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 5 } } values { test { points { counter: 7 replica: 1 } } } } }
    ops { set_remove { node { counter: 1 replica: 7 } set { segments { field: 1000 } segments { field: 6 } } values { test { nodes { counter: 1 replica: 7 } } } } }
  }
}
deliveries { order: [1, 2] }
deliveries { order: [2, 1] }
expect {
  state_hash: "d39932a4fc6986644d2992943866bacf6675e27bd3de96372d038b9ab7050520"
  node {
    id { counter: 1 replica: 7 }
    node_hash: "cfbe827b3ed163a811eae2f601934ebcbf390de66a5023a8a5a8e8b54f5893d1"
    set { path { segments { field: 1000 } segments { field: 5 } } members { test { points { counter: 8 replica: 1 } points { counter: 7 replica: 1 } } } }
    set { path { segments { field: 1000 } segments { field: 6 } } members { test { nodes { counter: 9 replica: 9 } } } }
  }
}
