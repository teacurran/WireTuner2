# crdt-conformance/vectors/registers/out-of-order-arrival.textproto (CRDT-001; schema: crdt-conformance/schema/vector.proto)
name: "registers/out-of-order-arrival"
description: "Writes to one register arrive in every order, the greatest OpId sometimes first; the result is the greatest OpId's value and the rest are retained as losing."
setup {
    change {
      replica: 7 seq: 1 start_counter: 1 label: "Create layer"
      ops { create { parent { counter: 4 } position: "\x80" props { layer { common { name: "Layer 1" } } } } }
    }
}
replica {
    id: 1
    change {
      replica: 1 seq: 1 start_counter: 2 label: "Rename"
      ops { set { node { counter: 1 replica: 7 }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 1 } }
        values { layer { common { name: "A" } } } } }
    }
    change {
      replica: 1 seq: 2 start_counter: 4 label: "Rename"
      ops { set { node { counter: 1 replica: 7 }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 1 } }
        values { layer { common { name: "C" } } } } }
    }
}
replica {
    id: 2
    change {
      replica: 2 seq: 1 start_counter: 3 label: "Rename"
      ops { set { node { counter: 1 replica: 7 }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 1 } }
        values { layer { common { name: "B" } } } } }
    }
}
deliveries { order: [1, 1, 2] }
deliveries { order: [2, 1, 1] }
deliveries { order: [1, 2, 1] }
expect {
  state_hash: "b06f00dfa68c96c553beb539a4eefb75fe5318ef77d7edf9f0542f49bab118f7"
  node {
    id { counter: 1 replica: 7 }
    node_hash: "01bb28430eeebce1e2ed18a542ff82910a0944c45a9fb5dc07627465c57b6499"
    register {
      path { segments { field: 150 } segments { field: 1 } segments { field: 1 } }
      value { layer { common { name: "C" } } }
      op { counter: 4 replica: 1 }
      losing { counter: 1 replica: 7 }
      losing { counter: 2 replica: 1 }
      losing { counter: 3 replica: 2 }
    }
  }
}
