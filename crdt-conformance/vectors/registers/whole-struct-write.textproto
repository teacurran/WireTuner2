# crdt-conformance/vectors/registers/whole-struct-write.textproto (CRDT-001; schema: crdt-conformance/schema/vector.proto)
name: "registers/whole-struct-write"
description: "A path naming a STRUCT field writes every register beneath it, absent leaves as unset, and each leaf then merges on its own: an earlier concurrent leaf write loses, a later one wins."
setup {
    change {
      replica: 7 seq: 1 start_counter: 1 label: "Create layer"
      ops { create { parent { counter: 4 } position: "\x80" props { layer { common { name: "Layer 1" } } } } }
    }
}
replica {
    id: 1
    change {
      replica: 1 seq: 1 start_counter: 3 label: "Set wrap and link"
      ops { set { node { counter: 1 replica: 7 }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 13 } }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 8 } }
        values { layer { common { navigation { target: LINK_TARGET_NEW_TAB } text_wrap { enabled: true } } } } } }
    }
}
replica {
    id: 2
    change {
      replica: 2 seq: 1 start_counter: 2 label: "Standoff"
      ops { set { node { counter: 1 replica: 7 }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 13 } segments { field: 2 } }
        values { layer { common { text_wrap { standoff: 4 } } } } } }
    }
}
replica {
    id: 3
    change {
      replica: 3 seq: 1 start_counter: 4 label: "Alt text"
      ops { set { node { counter: 1 replica: 7 }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 8 } segments { field: 1 } }
        values { layer { common { navigation { alt: "x" } } } } } }
    }
}
deliveries { order: [1, 2, 3] }
deliveries { order: [3, 2, 1] }
deliveries { order: [2, 3, 1] }
expect {
  state_hash: "809d19ea7ecb5495efffca8f7c4f7eb6314ef61f28789118e39bdf459fc16078"
  snapshot_hash: "e2ad83fd9e65f758c8137842fe72a716462faba8923139e108c6ac966650f29c"
  node {
    id { counter: 1 replica: 7 }
    node_hash: "60aa694721502885cd9cb755000a73f0e4697e5cefda3e84b5264fa44e3c54a3"
    register {
      path { segments { field: 150 } segments { field: 1 } segments { field: 13 } segments { field: 1 } }
      value { layer { common { text_wrap { enabled: true } } } }
      op { counter: 3 replica: 1 }
    }
    register {
      path { segments { field: 150 } segments { field: 1 } segments { field: 13 } segments { field: 2 } }
      op { counter: 3 replica: 1 }
      losing { counter: 2 replica: 2 }
    }
    register {
      path { segments { field: 150 } segments { field: 1 } segments { field: 8 } segments { field: 1 } }
      value { layer { common { navigation { alt: "x" } } } }
      op { counter: 4 replica: 3 }
      losing { counter: 3 replica: 1 }
    }
    register {
      path { segments { field: 150 } segments { field: 1 } segments { field: 8 } segments { field: 2 } }
      value { layer { common { navigation { target: LINK_TARGET_NEW_TAB } } } }
      op { counter: 3 replica: 1 }
    }
    register {
      path { segments { field: 150 } segments { field: 1 } segments { field: 8 } segments { field: 3 } }
      op { counter: 3 replica: 1 }
    }
  }
}
