# crdt-conformance/vectors/registers/clear-vs-concurrent-write.textproto (CRDT-001; schema: crdt-conformance/schema/vector.proto)
name: "registers/clear-vs-concurrent-write"
description: "Clearing a field (a path with no value) writes unset with the op's id and competes with concurrent writes by the same rule: the greater OpId wins whether it is the clear or the write."
setup {
    change {
      replica: 7 seq: 1 start_counter: 1 label: "Create layer"
      ops { create { parent { counter: 4 } position: "\x80" props { layer { common { name: "Layer 1" } } } } }
    }
    change {
      replica: 7 seq: 2 start_counter: 2 label: "Attach URL and note"
      ops { set { node { counter: 1 replica: 7 }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 6 } }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 2 } }
        values { layer { common { note: "n" url: "https://a.example" } } } } }
    }
}
replica {
    id: 1
    change {
      replica: 1 seq: 1 start_counter: 3 label: "Clear URL, clear note"
      ops { set { node { counter: 1 replica: 7 }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 6 } } } }
      ops { set { node { counter: 1 replica: 7 }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 2 } } } }
    }
}
replica {
    id: 2
    change {
      replica: 2 seq: 1 start_counter: 3 label: "Set URL and note"
      ops { set { node { counter: 1 replica: 7 }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 6 } }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 2 } }
        values { layer { common { note: "m" url: "https://b.example" } } } } }
    }
}
deliveries { order: [1, 2] }
deliveries { order: [2, 1] }
expect {
  state_hash: "fa4a6b856970d7ba60db6546f82278e5b1517008ca0cc67d84b838c83f5b0293"
  snapshot_hash: "3413d92bac7ae2625f3fc11abea05711030d53409b4b393b36b463dadebb3744"
  node {
    id { counter: 1 replica: 7 }
    node_hash: "5eb0bf8222251741f219952861c4206587a11083e0f5cf1bf52667fa8e734c27"
    register {
      path { segments { field: 150 } segments { field: 1 } segments { field: 6 } }
      value { layer { common { url: "https://b.example" } } }
      op { counter: 3 replica: 2 }
      losing { counter: 2 replica: 7 }
      losing { counter: 3 replica: 1 }
    }
    register {
      path { segments { field: 150 } segments { field: 1 } segments { field: 2 } }
      op { counter: 4 replica: 1 }
      losing { counter: 2 replica: 7 }
      losing { counter: 3 replica: 2 }
    }
  }
}
