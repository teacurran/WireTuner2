    node_hash: "377b70dcce84722adecd34e1b1871250041d91b67f5d1fa9347f29b4108509cc"
    register {
      path { segments { field: 5 } segments { field: 6 } }
      absent: true
    }
    register {
      path { segments { field: 5 } segments { field: 4 } }
      value { asset { media_type: "image/png" } }
      op { counter: 4 replica: 1 }
      losing { counter: 1 replica: 7 }
    }
  }
}
