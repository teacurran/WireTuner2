        paths { segments { field: 150 } segments { field: 1 } segments { field: 7 } segments { field: 1 } segments { field: 1 } }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 999 } }
        paths { segments { field: 150 } segments { element { counter: 1 replica: 1 } } }
        values { layer { common { name: "x" style { id { counter: 3 } } } } } } }
      ops { noop { } }
      ops { set { node { counter: 0 replica: 0 }
        paths { segments { field: 1 } segments { field: 1 } segments { field: 1 } }
        values { document { common { name: "Doc" } } } } }
    }
}
