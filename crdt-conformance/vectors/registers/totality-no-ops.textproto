        values { layer { common { name: "kindless" } } } } }
      ops { set { node { counter: 1 replica: 7 }
        paths { segments { field: 3 } segments { field: 1 } segments { field: 1 } }
        values { page { common { name: "page" } } } } }
      ops { set { node { counter: 1 replica: 7 }
