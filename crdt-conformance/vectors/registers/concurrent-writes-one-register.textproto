# crdt-conformance/vectors/registers/concurrent-writes-one-register.textproto (CRDT-001; schema: crdt-conformance/schema/vector.proto)
name: "registers/concurrent-writes-one-register"
description: "Three replicas rename one layer at the same counter; the greatest replica id, compared unsigned, wins and the other two writes are retained as losing."
setup {
    change {
      replica: 7 seq: 1 start_counter: 1 label: "Create layer"
      ops { create { parent { counter: 4 } position: "\x80" props { layer { common { name: "Layer 1" } } } } }
    }
}
replica {
    id: 1
    change {
      replica: 1 seq: 1 start_counter: 2 label: "Rename"
      ops { set { node { counter: 1 replica: 7 }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 1 } }
        values { layer { common { name: "Alice" } } } } }
    }
}
replica {
    id: 2
    change {
      replica: 2 seq: 1 start_counter: 2 label: "Rename"
      ops { set { node { counter: 1 replica: 7 }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 1 } }
        values { layer { common { name: "Bob" } } } } }
    }
}
replica {
    id: 18446744073709551600
    change {
      replica: 18446744073709551600 seq: 1 start_counter: 2 label: "Rename"
      ops { set { node { counter: 1 replica: 7 }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 1 } }
        values { layer { common { name: "Carol" } } } } }
    }
}
deliveries { order: [1, 2, 18446744073709551600] }
deliveries { order: [18446744073709551600, 2, 1] }
deliveries { order: [2, 18446744073709551600, 1] }
expect {
  state_hash: "b7d12bb8e6da3022fbcaf123380069f2d29a867c3bd5aeab20b13acee7c3d7ab"
  node {
    id { counter: 1 replica: 7 }
    node_hash: "c61161db47e24b3b0386f6a4317a08667a674ff12f060b21fc99bf404e58da13"
    register {
      path { segments { field: 150 } segments { field: 1 } segments { field: 1 } }
      value { layer { common { name: "Carol" } } }
      op { counter: 2 replica: 18446744073709551600 }
      losing { counter: 1 replica: 7 }
      losing { counter: 2 replica: 1 }
      losing { counter: 2 replica: 2 }
    }
  }
}
