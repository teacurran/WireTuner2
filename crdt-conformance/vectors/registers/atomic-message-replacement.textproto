# crdt-conformance/vectors/registers/atomic-message-replacement.textproto (CRDT-001; schema: crdt-conformance/schema/vector.proto)
name: "registers/atomic-message-replacement"
description: "An ATOMIC message (Transform, and Halftone by annotation) is one register: the later write replaces it whole, so no component of the earlier write survives."
setup {
    change {
      replica: 7 seq: 1 start_counter: 1 label: "Create layer"
      ops { create { parent { counter: 4 } position: "\x80" props { layer { common { name: "Layer 1" } } } } }
    }
}
replica {
    id: 1
    change {
      replica: 1 seq: 1 start_counter: 2 label: "Scale and screen"
      ops { set { node { counter: 1 replica: 7 }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 4 } }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 11 } }
        values { layer { common { transform { a: 1 d: 1 tx: 5 } halftone { shape: HALFTONE_SHAPE_ROUND angle: 45 } } } } } }
    }
}
replica {
    id: 2
    change {
      replica: 2 seq: 1 start_counter: 3 label: "Scale and screen"
      ops { set { node { counter: 1 replica: 7 }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 4 } }
        paths { segments { field: 150 } segments { field: 1 } segments { field: 11 } }
        values { layer { common { transform { a: 2 d: 2 ty: 7 } halftone { frequency: 150 } } } } } }
    }
}
deliveries { order: [1, 2] }
deliveries { order: [2, 1] }
expect {
  state_hash: "51d13631beece68c0967a00bf1445f9341d973abf0e21d885ac01f8275fe75c6"
  snapshot_hash: "a2ff5afee8b2d19c89791c2cbfec7318c5ece43ea52d68bf27e88baf7d0250dd"
  node {
    id { counter: 1 replica: 7 }
    node_hash: "f278998710a983c5b4b80c6cf3c5584b6f2e11a53dc651001f3cb6449e425976"
    register {
      path { segments { field: 150 } segments { field: 1 } segments { field: 4 } }
      value { layer { common { transform { a: 2 d: 2 ty: 7 } } } }
      op { counter: 3 replica: 2 }
      losing { counter: 2 replica: 1 }
    }
    register {
      path { segments { field: 150 } segments { field: 1 } segments { field: 11 } }
      value { layer { common { halftone { frequency: 150 } } } }
      op { counter: 3 replica: 2 }
      losing { counter: 2 replica: 1 }
    }
  }
}
