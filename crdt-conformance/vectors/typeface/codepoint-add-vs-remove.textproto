# crdt-conformance/vectors/typeface/codepoint-add-vs-remove.textproto (FONT-001, FONT-008; schema: crdt-conformance/schema/vector.proto)
name: "typeface/codepoint-add-vs-remove"
description: "GlyphProps.codepoints is a SET of varint scalars (add-wins).  Glyph A encodes U+0041.  Replica 2 removes U+0041 (observing the setup's add); replica 1 concurrently adds U+0041 again and U+0391.  U+0041 stays (the concurrent add was not observed by the remove) and U+0391 is added."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Glyph A"
    ops { create { parent { counter: 11 } position: "\x80" props { glyph { name: "A" advance_width: 500 } } } }
    ops { set_add { node { counter: 1 replica: 7 } set { segments { field: 220 } segments { field: 3 } } values { glyph { codepoints: 65 } } } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 3 base_server_seq: 1 server_seq: 3 label: "Set Unicode"
    ops { set_add { node { counter: 1 replica: 7 } set { segments { field: 220 } segments { field: 3 } } values { glyph { codepoints: 65 codepoints: 913 } } } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 3 base_server_seq: 1 server_seq: 2 label: "Set Unicode"
    ops { set_remove { node { counter: 1 replica: 7 } set { segments { field: 220 } segments { field: 3 } } values { glyph { codepoints: 65 } } } }
  }
}
deliveries { order: [1, 2] }
deliveries { order: [2, 1] }
expect {
  state_hash: "3a776f9b64291be0a4feee282ce0a9942c9884a9a2bbd0f1444c7ac569546f94"
  snapshot_hash: "1174f9e340ad8f38e86e5e02d5360a3afdf41dedba4f9982b4a4be981e2b2335"
  node {
    id { counter: 1 replica: 7 }
    set { path { segments { field: 220 } segments { field: 3 } } members { glyph { codepoints: 65 codepoints: 913 } } }
  }
}
