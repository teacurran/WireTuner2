# crdt-conformance/vectors/typeface/glyph-delete-vs-draw.textproto (FONT-002, FONT-008; schema: crdt-conformance/schema/vector.proto)
name: "typeface/glyph-delete-vs-draw"
description: "Replica 1 removes glyph A while replica 2 draws on it.  The glyph is deleted and the new rectangle is live with canvas still naming the glyph: clients read the dangling canvas as unset and show the rectangle on the Sketches pasteboard; Restore glyph (deleted = false) re-attaches it without writing the rectangle."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Typeface with glyph A and a layer"
    ops { set { node { counter: 1 } paths { segments { field: 2 } segments { field: 20 } } values { settings { document_kind: DOCUMENT_KIND_TYPEFACE } } } }
    ops { create { parent { counter: 11 } position: "\x80" props { glyph { name: "A" advance_width: 500 } } } }
    ops { create { parent { counter: 4 } position: "\x80" props { layer { common { name: "Layer 1" } } } } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 4 base_server_seq: 1 label: "Remove glyph A"
    ops { set_deleted { node { counter: 2 replica: 7 } deleted: true } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 4 base_server_seq: 1 label: "Draw on A"
    ops { create { parent { counter: 3 replica: 7 } position: "\x80" props { rect { common { canvas { id { counter: 2 replica: 7 } } } size { width: 100 height: 700 } } } } }
  }
}
deliveries { order: [1, 2] }
deliveries { order: [2, 1] }
expect {
  state_hash: "1037a0e9ae2fca9aaa95a99faccaf4bfa4097e26cb9acdd140d3f19cbb3a2c11"
  snapshot_hash: "d88655854c24b96a3b0fcb8c7f0dd68ca89158a76343c3b864d309ae80b6412c"
  node {
    id { counter: 2 replica: 7 }
    tree { parent { counter: 11 } position: "\x80" deleted: true }
  }
  node {
    id { counter: 4 replica: 2 }
    tree { parent { counter: 3 replica: 7 } position: "\x80" }
    register {
      path { segments { field: 21 } segments { field: 1 } segments { field: 5 } }
      value { rect { common { canvas { id { counter: 2 replica: 7 } } } } }
      op { counter: 4 replica: 2 }
    }
  }
}
