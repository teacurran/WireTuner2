# crdt-conformance/vectors/text/typing-into-deleted-word.textproto (CRDT-005; schema: crdt-conformance/schema/vector.proto)
name: "text/typing-into-deleted-word"
description: "Replica 1 deletes \"or\" from \"word\" while replica 2 types X between the o and the r.  The X lands where its origins say, between the two tombstones: wXd, with o and r kept as tombstones."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Type"
    ops { create { parent { counter: 4 } position: "\x80" props { test { label: "T" } } } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } chars: "word" } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 6 base_server_seq: 1 label: "Delete text"
    ops { text_delete { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } ranges { first { counter: 3 replica: 7 } count: 2 } } }
  }
}
replica { id: 2 change { replica: 2 seq: 1 start_counter: 6 base_server_seq: 1 label: "Type" ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 3 replica: 7 } right_origin { counter: 4 replica: 7 } chars: "X" } } } }
deliveries { order: [1, 2] }
deliveries { order: [2, 1] }
expect {
  state_hash: "02ba81b51f00cc8514067ac63e5bc1ec4f9436e7fcba0f76a5db616c26a95328"
  snapshot_hash: "794aeb08181804899766bfe682b4056e7a0be96b6efe891885e4f52806383cac"
  node {
    id { counter: 1 replica: 7 }
    node_hash: ""
    text { path { segments { field: 1000 } segments { field: 9 } } text: "wXd" chars { counter: 2 replica: 7 } chars { counter: 6 replica: 2 } chars { counter: 5 replica: 7 } deleted { counter: 3 replica: 7 } deleted { counter: 4 replica: 7 } runs { start: 0 length: 3 } }
  }
}
