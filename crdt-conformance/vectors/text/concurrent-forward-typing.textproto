# crdt-conformance/vectors/text/concurrent-forward-typing.textproto (CRDT-005; schema: crdt-conformance/schema/vector.proto)
name: "text/concurrent-forward-typing"
description: "Fugue: two replicas type a word each at the same spot, one character per op (each character's left origin is the one before it).  The runs never interleave: the run whose first character has the smaller OpId comes first, XabxyY."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Type"
    ops { create { parent { counter: 4 } position: "\x80" props { test { label: "T" } } } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } chars: "XY" } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 4 base_server_seq: 1 label: "Type"
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 2 replica: 7 } right_origin { counter: 3 replica: 7 } chars: "a" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 4 replica: 1 } right_origin { counter: 3 replica: 7 } chars: "b" } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 4 base_server_seq: 1 label: "Type"
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 2 replica: 7 } right_origin { counter: 3 replica: 7 } chars: "x" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 4 replica: 2 } right_origin { counter: 3 replica: 7 } chars: "y" } }
  }
}
deliveries { order: [1, 2] }
deliveries { order: [2, 1] }
expect {
  state_hash: "f8f711d4b7d34677ec6a7bd70ee375f002c15604e46e59f67464175bb671be66"
  snapshot_hash: "8af6f459a2ccb5c56f694897225e8d4dbf4ebbce14adb9871630b8d0dd9e59a9"
  node {
    id { counter: 1 replica: 7 }
    node_hash: ""
    text { path { segments { field: 1000 } segments { field: 9 } } text: "XabxyY" chars { counter: 2 replica: 7 } chars { counter: 4 replica: 1 } chars { counter: 5 replica: 1 } chars { counter: 4 replica: 2 } chars { counter: 5 replica: 2 } chars { counter: 3 replica: 7 }  runs { start: 0 length: 6 } }
  }
}
