# crdt-conformance/vectors/text/totality-no-ops.textproto (CRDT-005; schema: crdt-conformance/schema/vector.proto)
name: "text/totality-no-ops"
description: "Text ops the engines cannot use are deterministic no-ops: an unknown origin, a path that is not a TEXT field (an ATOMIC field, a path past the TEXT field, an unknown node), a delete of ids the text does not hold, a mark with an unknown anchor, and a paragraph register on a character that is not a newline.  A mark whose value sets no attribute is kept but formats nothing."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Type"
    ops { create { parent { counter: 4 } position: "\x80" props { test { label: "T" } } } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } chars: "ab" } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 4 base_server_seq: 1 label: "No-ops"
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 99 replica: 9 } chars: "x" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 2 } } chars: "x" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } segments { field: 1 } } chars: "x" } }
    ops { text_insert { node { counter: 50 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } chars: "x" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } segments { element { counter: 2 replica: 7 } } } chars: "x" } }
    ops { text_delete { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } ranges { first { counter: 40 replica: 7 } count: 3 } } }
    ops { text_mark { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } start { char { counter: 99 replica: 9 } before: true } end { char { counter: 3 replica: 7 } } value { bold: true } } }
    ops { set { node { counter: 1 replica: 7 } paths { segments { field: 1000 } segments { field: 9 } segments { element { counter: 2 replica: 7 } } segments { field: 6 } segments { field: 1 } } values { test { text { chars { paragraph { alignment: 3 } } } } } } }
    ops { text_mark { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } start { before: true } end { } } }
  }
}
expect {
  state_hash: "932995a87dff71e48b19f73232786e7b44993f3ce9409d5d19e04e398911223b"
  snapshot_hash: "1e95914d661097082281d9e19c5914d21feecc2d498237e94a359aa8612cdb3c"
  node {
    id { counter: 1 replica: 7 }
    node_hash: ""
    text { path { segments { field: 1000 } segments { field: 9 } } text: "ab" chars { counter: 2 replica: 7 } chars { counter: 3 replica: 7 }  runs { start: 0 length: 2 } }
  }
}
