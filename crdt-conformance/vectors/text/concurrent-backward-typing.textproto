# crdt-conformance/vectors/text/concurrent-backward-typing.textproto (CRDT-005; schema: crdt-conformance/schema/vector.proto)
name: "text/concurrent-backward-typing"
description: "Fugue: two replicas type a word backwards at the same spot (each character goes before the one typed last, so its right origin is that character).  Each run is a chain of left children and the runs still never interleave: XabcxyzY."
setup {
  change {
    replica: 7 seq: 1 start_counter: 1 label: "Type"
    ops { create { parent { counter: 4 } position: "\x80" props { test { label: "T" } } } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } chars: "XY" } }
  }
}
replica {
  id: 1
  change {
    replica: 1 seq: 1 start_counter: 4 base_server_seq: 1 label: "Type"
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 2 replica: 7 } right_origin { counter: 3 replica: 7 } chars: "c" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 2 replica: 7 } right_origin { counter: 4 replica: 1 } chars: "b" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 2 replica: 7 } right_origin { counter: 5 replica: 1 } chars: "a" } }
  }
}
replica {
  id: 2
  change {
    replica: 2 seq: 1 start_counter: 4 base_server_seq: 1 label: "Type"
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 2 replica: 7 } right_origin { counter: 3 replica: 7 } chars: "z" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 2 replica: 7 } right_origin { counter: 4 replica: 2 } chars: "y" } }
    ops { text_insert { node { counter: 1 replica: 7 } text { segments { field: 1000 } segments { field: 9 } } left_origin { counter: 2 replica: 7 } right_origin { counter: 5 replica: 2 } chars: "x" } }
  }
}
deliveries { order: [1, 2] }
deliveries { order: [2, 1] }
expect {
  state_hash: "8c3f09346263620d1d246428218075a6a9cc530e6f4e5753c5ab7ac3757990d9"
  snapshot_hash: "c56d4a65998ad46d5537c0ef2a0846699fc7b06d22aadeb13ba161f9cc3844bf"
  node {
    id { counter: 1 replica: 7 }
    node_hash: ""
    text { path { segments { field: 1000 } segments { field: 9 } } text: "XabcxyzY" chars { counter: 2 replica: 7 } chars { counter: 6 replica: 1 } chars { counter: 5 replica: 1 } chars { counter: 4 replica: 1 } chars { counter: 6 replica: 2 } chars { counter: 5 replica: 2 } chars { counter: 4 replica: 2 } chars { counter: 3 replica: 7 }  runs { start: 0 length: 8 } }
  }
}
