        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(wt_ingest_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
