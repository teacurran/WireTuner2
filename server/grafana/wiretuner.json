{
  "uid": "wiretuner",
  "title": "WireTuner",
  "description": "WireTuner API: per-document sync health and per-RPC traffic (docs/spec/server.adoc, Observability).",
  "tags": [
    "wiretuner"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
