  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@wiretuner.local",
    "fromDisplayName": "WireTuner"
  },
  "webAuthnPolicyPasswordlessRpEntityName": "WireTuner",
  "webAuthnPolicyPasswordlessSignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyPasswordlessRpId": "",
  "webAuthnPolicyPasswordlessAttestationConveyancePreference": "not specified",
  "webAuthnPolicyPasswordlessAuthenticatorAttachment": "platform",
  "webAuthnPolicyPasswordlessRequireResidentKey": "Yes",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessCreateTimeout": 0,
  "webAuthnPolicyPasswordlessAvoidSameAuthenticatorRegister": true,
  "webAuthnPolicyPasswordlessAcceptableAaguids": [],
  "webAuthnPolicyPasswordlessExtraOrigins": [],
  "webAuthnPolicyPasswordlessPasskeysEnabled": false,
  "browserFlow": "wiretuner browser",
  "directGrantFlow": "wiretuner direct grant",
  "firstBrokerLoginFlow": "wiretuner first broker login",
  "authenticationFlows": [
    {
      "alias": "wiretuner browser",
      "description": "Passkey first (docs/spec/security.adoc, Accounts): a cookie, an identity-provider hint (Apple, a workspace), or the username then a passkey, with the password as the other way.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-cookie",
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "wiretuner browser forms"
        }
      ]
    },
    {
      "alias": "wiretuner browser forms",
      "description": "Username, then a passkey or the password.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-username-form",
          "authenticatorFlow": false
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "wiretuner passkey or password"
        }
      ]
    },
    {
      "alias": "wiretuner passkey or password",
      "description": "The passwordless WebAuthn execution first; the password is 'Try another way'. Each carries its AMR reference, which the wt_auth_method fallback reads.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "webauthn-authenticator-passwordless",
          "authenticatorFlow": false,
          "authenticatorConfig": "amr passkey"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "auth-password-form",
          "authenticatorFlow": false,
          "authenticatorConfig": "amr password"
        }
      ]
    },
    {
      "alias": "wiretuner direct grant",
      "description": "Password grant (tests and tooling only; the Mac uses the browser flow), with the password's AMR reference.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "direct-grant-validate-username",
          "authenticatorFlow": false
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "direct-grant-validate-password",
          "authenticatorFlow": false,
          "authenticatorConfig": "amr password direct"
        }
      ]
    },
    {
      "alias": "wiretuner test passkey direct grant",
      "description": "Test only (SRV-002, SEC-004): a password grant whose password execution carries the passkey AMR reference, so the wt_auth_method mapping of a passkey sign-in is tested end to end with a password-grant token.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "direct-grant-validate-username",
          "authenticatorFlow": false
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "direct-grant-validate-password",
          "authenticatorFlow": false,
          "authenticatorConfig": "amr passkey stand-in"
        }
      ],
      "id": "7e5a3c52-2f0a-4c7e-9a51-5a3e0b6f1c01"
    },
    {
      "alias": "wiretuner first broker login",
      "description": "Account linking (docs/spec/security.adoc, Account linking): a brokered identity (Apple, a workspace) whose provider's email is trusted as verified links to the existing account with that email; otherwise a new account.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "idp-review-profile",
          "authenticatorFlow": false,
          "authenticatorConfig": "review profile missing"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "wiretuner user creation or linking"
        }
      ]
    },
    {
      "alias": "wiretuner user creation or linking",
      "description": "A new account when the email is unique, else link.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "idp-create-user-if-unique",
          "authenticatorFlow": false,
          "authenticatorConfig": "create unique user"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "wiretuner link existing account"
        }
      ]
    },
    {
      "alias": "wiretuner link existing account",
      "description": "Link to the account that has the verified email.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "idp-detect-existing-broker-user",
          "authenticatorFlow": false
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "idp-auto-link",
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "amr passkey",
      "config": {
        "default.reference.value": "passkey",
        "default.reference.maxAge": "0"
      }
    },
    {
      "alias": "amr password",
      "config": {
        "default.reference.value": "password",
        "default.reference.maxAge": "0"
      }
    },
    {
      "alias": "amr password direct",
      "config": {
        "default.reference.value": "password",
        "default.reference.maxAge": "0"
      }
    },
    {
      "alias": "amr passkey stand-in",
      "config": {
        "default.reference.value": "passkey",
        "default.reference.maxAge": "0"
      }
    },
    {
      "alias": "review profile missing",
      "config": {
        "update.profile.on.first.login": "missing"
      }
    },
    {
      "alias": "create unique user",
      "config": {
        "require.password.update.after.registration": "false"
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "apple",
      "displayName": "Sign in with Apple",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "wiretuner first broker login",
      "linkOnly": false,
      "hideOnLogin": false,
      "config": {
        "clientId": "app.wiretuner.signin",
        "clientSecret": "replaced-by-the-apple-secret-job",
        "clientAuthMethod": "client_secret_post",
        "authorizationUrl": "http://localhost:8190/apple/authorize",
        "tokenUrl": "http://apple-mock:8080/apple/token",
        "jwksUrl": "http://apple-mock:8080/apple/jwks",
        "issuer": "http://apple-mock:8080/apple",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "defaultScope": "openid name email",
        "syncMode": "IMPORT",
        "pkceEnabled": "false",
        "disableUserInfo": "true"
      }
    },
    {
      "alias": "acme",
      "displayName": "Acme (workspace SSO)",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "wiretuner first broker login",
      "linkOnly": false,
      "hideOnLogin": false,
      "config": {
        "clientId": "wiretuner",
        "clientSecret": "acme-local-secret",
        "clientAuthMethod": "client_secret_post",
        "authorizationUrl": "http://localhost:8190/acme/authorize",
        "tokenUrl": "http://apple-mock:8080/acme/token",
        "jwksUrl": "http://apple-mock:8080/acme/jwks",
        "issuer": "http://apple-mock:8080/acme",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT",
        "pkceEnabled": "false",
        "disableUserInfo": "true"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "wt_auth_method apple",
      "identityProviderAlias": "apple",
      "identityProviderMapper": "hardcoded-user-session-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "attribute": "wt_auth_method",
        "attribute.value": "apple"
      }
    },
    {
      "name": "wt_auth_method sso:acme",
      "identityProviderAlias": "acme",
      "identityProviderMapper": "hardcoded-user-session-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "attribute": "wt_auth_method",
        "attribute.value": "sso:acme"
      }
    }
  ]
}
