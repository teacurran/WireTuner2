// Signing for the WireTuner app target.
//
// Nothing here names a team, and DEVELOPMENT_TEAM is deliberately not assigned in this file
// or in project.yml.  xcodebuild does not import shell environment variables as build
// settings (verified: an exported DEVELOPMENT_TEAM is invisible to -showBuildSettings), so the
// team reaches the build as a command-line override, which beats every xcconfig value:
//
//     xcodebuild ... DEVELOPMENT_TEAM="$DEVELOPMENT_TEAM" CODE_SIGN_IDENTITY="Developer ID Application"
//
// `make client-build` and the CI workflow pass exactly that, reading DEVELOPMENT_TEAM from
// their own environment.  With no override (a fresh checkout, a CI runner without
// certificates) the app is ad-hoc signed ("-") with no team, which is enough to build, run
// and test locally.  Notarization and the Developer ID profile are wired by the distribution
// task; this file is where they plug in.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = YES
OTHER_CODE_SIGN_FLAGS = --timestamp=none
PROVISIONING_PROFILE_SPECIFIER =
