{
  "_comment": "QuarkXPress's Mac shortcuts where a WireTuner command corresponds. Commands not listed keep the WireTuner set's keys; a key listed here is taken away from every other command.",
  "format": "wtkeys",
  "version": 1,
  "id": "builtin.quarkxpress",
  "name": "QuarkXPress",
  "based_on": "builtin.wiretuner",
  "updated_at_ms": 0,
  "bindings": [
    { "command_id": "app.settings", "keys": ["cmd+opt+shift+y", "cmd+,"] },
    { "command_id": "view.fitPage", "keys": ["cmd+0"] },
    { "command_id": "view.fitAll", "keys": ["cmd+opt+0"] },
    { "command_id": "tool.line", "keys": ["l", "4"] },
    { "command_id": "tool.lasso", "keys": [] },
    { "command_id": "tool.rectangle", "keys": ["b", "2"] },
    { "command_id": "tool.bezigon", "keys": ["shift+b", "5"] },
    { "command_id": "tool.hand", "keys": ["x"] },
    { "command_id": "tool.extrude", "keys": [] }
  ]
}
